meta {
  name: 1 - Creer un colis
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/colis
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "agenceOrigineId": 1,
    "agenceRetraitId": 2,
    "expediteurNom": "Marc Lemoine",
    "expediteurTelephone": "+33698765432",
    "expediteurEmail": "marc.lemoine@exemple.fr",
    "destinataireNom": "Pierre Rousseau",
    "destinataireTelephone": "+33687654321",
    "destinataireEmail": "pierre.rousseau@exemple.fr",
    "destinataireAdresse": "8 Rue de la Republique, 69002 Lyon",
    "destinataireVille": "Lyon",
    "description": "Vetements et electronique",
    "poids": 3.500
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    var json = res.getBody();
    bru.setVar('colisId', json.id);
    bru.setVar('codeTracking', json.codeTracking);
    console.log('colisId capture : ' + json.id + ' | code : ' + json.codeTracking);
  }
}

settings {
  encodeUrl: true
}
