script:post-response {
  if (res.getStatus() === 200) {
    var json = res.getBody();
    console.log('Sync terminee : ' + json.nbColisReussis + ' colis reussis, ' + json.nbColisDoublons + ' doublons, ' + json.nbColisEchecs + ' echecs');
  }
}

settings {
  encodeUrl: true
}
