meta {
  name: 1 - Synchroniser colis hors-ligne
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/sync
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

