script:post-response {
  if (res.getStatus() === 200) {
    var json = res.getBody();
    console.log('Sync terminee : ' + json.nbReussis + ' reussis, ' + json.nbDoublons + ' doublons, ' + json.nbEchecs + ' echecs');
  }
}

settings {
  encodeUrl: true
}
