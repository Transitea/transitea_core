meta {
  name: 2 - Sync avec doublon (idempotence)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/sync/upload
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "colis": [
      {
        "agenceOrigineId": 1,
        "agenceRetraitId": 2,
        "expediteurNom": "Marc Lemoine",
        "expediteurTelephone": "+33698765432",
        "destinataireNom": "Julie Blanchard",
        "destinataireVille": "Lyon",
        "description": "Vetements",
        "poids": 3.500,
        "localId": 1001
      }
    ],
    "misesAJourStatut": []
  }
}

docs {
  Renvoyer le meme localId doit retourner doublon=true sans creer de doublon en BDD.
  nbColisDoublons doit etre 1, nbColisReussis doit etre 0.
}

settings {
  encodeUrl: true
}
